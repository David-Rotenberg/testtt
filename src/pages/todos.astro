---
// Generated by @seyuna/generator — page emitter.
import Layout from '../layouts/App.astro';
import { Badge, Button, Card, Container, Field, Form, Heading, List, RequireAuth, Spacer, Stack, Submit, Text, UserMenu } from '@seyuna/components';
---

<Layout title="My Todos">
  <RequireAuth level={"required"} redirectTo={"/sign-in"}>
    <Container maxWidth={"md"} padding={"lg"}>
      <Stack align={"center"} direction={"row"} gap={"md"}>
        <Heading level={1} text={"My Todos"} />
        <Spacer size={"sm"} />
        <UserMenu showAvatar={true} showEmail={true} />
      </Stack>
      <Spacer size={"md"} />
      <Card tone={"default"}>
        <Form action={"createTodo"} submitLabel={"Add Todo"}>
          <Field label={"New Task"} name={"title"} placeholder={"What do you need to do?"} required={true} type={"text"} />
          <Submit label={"Add Todo"} variant={"primary"} />
        </Form>
      </Card>
      <Spacer size={"lg"} />
      <List emptyMessage={"No todos yet — add one above!"} itemTemplate={"detailed"} model={"Todo"}>
        <Card tone={"default"}>
          <Stack align={"center"} direction={"row"} gap={"md"}>
            <Text size={"base"} text={"{{item.title}}"} />
            <Spacer size={"sm"} />
            <Badge text={"{{item.completed ? 'Done' : 'Pending'}}"} tone={"default"} />
            <Button action={"completeTodo"} label={"Complete"} size={"sm"} variant={"secondary"} />
            <Button action={"deleteTodo"} label={"Delete"} size={"sm"} variant={"destructive"} />
          </Stack>
        </Card>
      </List>
    </Container>
  </RequireAuth>
</Layout>
