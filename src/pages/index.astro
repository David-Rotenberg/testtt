---
// Generated by @seyuna/generator — page emitter.
import Layout from '../layouts/Marketing.astro';
import { Button, Card, Container, Footer, Grid, Heading, NavBar, Section, Spacer, Stack, Text } from '@seyuna/components';
---

<Layout title="Home">
  <NavBar brand={"TodoApp"} links={[]} sticky={true}>
    <Stack direction={"row"} gap={"sm"}>
      <Button href={"/sign-in"} label={"Sign In"} variant={"ghost"} />
      <Button href={"/sign-up"} label={"Get Started"} variant={"primary"} />
    </Stack>
  </NavBar>
  <Section tone={"default"}>
    <Container maxWidth={"md"} padding={"lg"}>
      <Stack align={"center"} direction={"column"} gap={"lg"}>
        <Heading align={"center"} level={1} text={"Stay on top of your tasks"} />
        <Text size={"lg"} text={"A simple, distraction-free todo app to help you stay organized and get things done."} tone={"muted"} />
        <Button href={"/sign-up"} label={"Start for free"} size={"lg"} variant={"primary"} />
      </Stack>
    </Container>
  </Section>
  <Section tone={"muted"}>
    <Container maxWidth={"lg"} padding={"lg"}>
      <Heading align={"center"} level={2} text={"Everything you need"} />
      <Spacer size={"md"} />
      <Grid columns={3} gap={"md"}>
        <Card description={"Quickly add tasks with a simple form. No fuss, just productivity."} title={"Create Tasks"} />
        <Card description={"Check off tasks as you finish them and watch your list shrink."} title={"Mark Complete"} />
        <Card description={"All your tasks in one place, sorted by when you added them."} title={"Stay Organized"} />
      </Grid>
    </Container>
  </Section>
  <Footer copyright={"© 2024 TodoApp. All rights reserved."} links={[{"label":"Sign In","href":"/sign-in"},{"label":"Sign Up","href":"/sign-up"}]} />
</Layout>
